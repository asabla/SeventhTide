{
  "name": "seventh-tide",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.3"
  },
  "scripts": {
    "dev": "vite web",
    "start": "node server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "build": "vite build web",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
