{
  "name": "seventh-tide",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.3"
  },
  "allowScripts": {
    "fsevents": false
  },
  "scripts": {
    "dev": "vite web",
    "start": "node server/start.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "vite build web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run coverage && npm run build",
    "test:db": "node --test tests/integration/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:code": "oxlint --deny-warnings --report-unused-disable-directives-severity error .",
    "lint:css": "stylelint \"web/**/*.css\" --max-warnings 0",
    "lint:html": "html-validate \"web/**/*.html\"",
    "lint": "npm run lint:code && npm run lint:css && npm run lint:html",
    "coverage": "node --test --experimental-test-coverage \"--test-coverage-include=packages/rules/**/*.ts\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 tests/*.test.ts",
    "simulate": "node verification/voyage/simulate.ts",
    "balance": "node verification/voyage/balance.ts",
    "audit:routes": "node verification/voyage/audit-routes.ts",
    "audit:landfall": "node verification/voyage/audit-landfall.ts",
    "check:ci": "npm run check && npm run test:db && npm run simulate -- 384 --require-all-endings && npm run audit:routes -- 4 --all-decisions --summary && npm run audit:landfall -- 4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "html-validate": "11.21.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
