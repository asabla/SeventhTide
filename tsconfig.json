{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "vite/client"]
  },
  "include": ["web/**/*.ts", "server/**/*.ts", "packages/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
